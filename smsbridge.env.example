# Huawei modem
MODEM_URL=http://192.168.8.1

# SMS delivery recipient.
# Legacy names TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID/EMAIL_TO/SMTP_* are still supported,
# but new deployments should use SMS_* names to keep roles explicit.
SMS_TELEGRAM_BOT_TOKEN=
SMS_TELEGRAM_CHAT_ID=

SMS_EMAIL_TO=
SMS_EMAIL_FROM=
SMS_EMAIL_SUBJECT_PREFIX=[SMSBridge]

SMS_SMTP_HOST=smtp.example.com
SMS_SMTP_PORT=587
SMS_SMTP_USER=
SMS_SMTP_PASS=
SMS_SMTP_TLS=yes

# Polling/runtime
COUNT_POLL_SECONDS=1
POLL_INTERVAL_SECONDS=1
HTTP_TIMEOUT_SECONDS=5
MAX_FETCH=50

# Storage/logging
STATE_DIR=/var/lib/smsbridge
LOG_DIR=/var/log/smsbridge
LOG_LEVEL=INFO

# Administrator alerts.
# Admin Telegram uses a separate bot; Telegram delivery requires chat_id, not username.
ADMIN_ALERT_ENABLED=yes
ADMIN_TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=
ADMIN_TELEGRAM_USERNAME_HINT=@example

# Admin email uses the same SMTP account by default. Leave ADMIN_SMTP_* empty
# to fall back to SMS_SMTP_* / SMTP_* credentials.
ADMIN_EMAIL_TO=
ADMIN_EMAIL_FROM=
ADMIN_EMAIL_SUBJECT_PREFIX=[SMSBridge ALERT]
ADMIN_SMTP_HOST=
ADMIN_SMTP_PORT=587
ADMIN_SMTP_USER=
ADMIN_SMTP_PASS=
ADMIN_SMTP_TLS=yes

ADMIN_ALERT_AFTER_CONSECUTIVE_RUNTIME_FAILURES=5
ADMIN_ALERT_REPEAT_SECONDS=3600
ADMIN_ALERT_LOG_LINES=120
ADMIN_ALERT_SEND_RECOVERY=yes
ADMIN_ALERT_STALE_HEARTBEAT_SECONDS=600
